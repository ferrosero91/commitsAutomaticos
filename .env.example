# Copia este archivo a .env, pon tus valores y cárgalo con --env-file .env
# o exporta las variables en tu shell. .env está ignorado por git.

# Clave de OpenCode (https://opencode.ai/console).
OPENCODE_API_KEY=

# Opcionales: modelo y base de la API V2.
AUTOCOMMIT_AI_MODEL=deepseek-v4.1-flash
AUTOCOMMIT_AI_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Tokens de GitHub por colaborador (si no usas el archivo seguro ni el prompt).
# El nombre se normaliza: minúsculas a mayúsculas y caracteres no alfanuméricos a "_".
# AUTOCOMMIT_TOKEN_ADA_LOVELACE=
# AUTOCOMMIT_TOKEN_ALAN_TURING=
